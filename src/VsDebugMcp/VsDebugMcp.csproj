<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Public API is documented in docs/TOOLS.md (pinned by DocsContractTests);
         the doc file exists only so IDE0005 can run on build. -->
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <NuGetAudit>true</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>VsDebugMcp.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="System.Management" Version="10.0.13" />
  </ItemGroup>

  <!-- Build-time only: embedded interop types, no runtime PIA dependency.
       Runtime binds the DTE object from the ROT (never a hardcoded ProgID).
       Prefer $(VSINSTALLDIR) (VS Developer prompt, or CI vswhere step that exports it);
       fall back to the local Enterprise, Professional, then Community install. Exists conditions keep this working
       across VS editions (Enterprise/Professional/Community). -->
  <PropertyGroup>
    <VsPublicAssemblies Condition="Exists('$(VSINSTALLDIR)Common7\IDE\PublicAssemblies\EnvDTE.dll')">$(VSINSTALLDIR)Common7\IDE\PublicAssemblies\</VsPublicAssemblies>
    <VsPublicAssemblies Condition="'$(VsPublicAssemblies)' == '' And Exists('C:\Program Files\Microsoft Visual Studio\18\Enterprise\Common7\IDE\PublicAssemblies\EnvDTE.dll')">C:\Program Files\Microsoft Visual Studio\18\Enterprise\Common7\IDE\PublicAssemblies\</VsPublicAssemblies>
    <VsPublicAssemblies Condition="'$(VsPublicAssemblies)' == '' And Exists('C:\Program Files\Microsoft Visual Studio\18\Professional\Common7\IDE\PublicAssemblies\EnvDTE.dll')">C:\Program Files\Microsoft Visual Studio\18\Professional\Common7\IDE\PublicAssemblies\</VsPublicAssemblies>
    <VsPublicAssemblies Condition="'$(VsPublicAssemblies)' == ''">C:\Program Files\Microsoft Visual Studio\18\Community\Common7\IDE\PublicAssemblies\</VsPublicAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="EnvDTE" Condition="Exists('$(VsPublicAssemblies)EnvDTE.dll')">
      <HintPath>$(VsPublicAssemblies)EnvDTE.dll</HintPath>
    </Reference>
    <Reference Include="EnvDTE80" Condition="Exists('$(VsPublicAssemblies)EnvDTE80.dll')">
      <HintPath>$(VsPublicAssemblies)EnvDTE80.dll</HintPath>
    </Reference>
    <Reference Include="EnvDTE90" Condition="Exists('$(VsPublicAssemblies)EnvDTE90.dll')">
      <HintPath>$(VsPublicAssemblies)EnvDTE90.dll</HintPath>
    </Reference>
    <Reference Include="EnvDTE100" Condition="Exists('$(VsPublicAssemblies)EnvDTE100.dll')">
      <HintPath>$(VsPublicAssemblies)EnvDTE100.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.Interop" Condition="Exists('$(VsPublicAssemblies)Microsoft.VisualStudio.Interop.dll')">
      <HintPath>$(VsPublicAssemblies)Microsoft.VisualStudio.Interop.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Clear no-VS message: without EnvDTE the Reference items above vanish and
       the build would fail with confusing unknown-type errors instead. -->
  <Target Name="CheckVsInstall" BeforeTargets="BeforeBuild" Condition="!Exists('$(VsPublicAssemblies)EnvDTE.dll')">
    <Error Text="No Visual Studio 2026 EnvDTE found at '$(VsPublicAssemblies)'. Build from a VS Developer prompt (sets VSINSTALLDIR) or retarget the HintPaths above; see docs/TROUBLESHOOTING.md (EnvDTE HintPath misses). Runtime binds DTE from the ROT, never a hardcoded ProgID." />
  </Target>

</Project>
